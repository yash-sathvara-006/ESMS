# ==============================================================================
# Enterprise Employee Salary Management System (ESMS) - Backend Environment Template
# ==============================================================================

# Server Network Configuration
PORT=your_port_here
NODE_ENV=your_node_env_here

# Database Configuration (e.g. sqlite or postgresql)
DB_PROVIDER=your_database_provider_here
DATABASE_URL="your_database_url_here"

# Cross-Origin Resource Sharing (CORS) - Allowed Frontend URL (e.g. http://localhost:5173)
CORS_ORIGIN="your_frontend_origin_here"

# Database Auto-Seeding Options (e.g. true / false)
AUTO_SEED=your_auto_seed_flag_here
SEED_EMPLOYEE_COUNT=your_seed_employee_count_here
