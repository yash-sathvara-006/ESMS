{
    "name": "esms-monorepo",
    "version": "1.0.0",
    "private": true,
    "description": "Enterprise Employee Salary Management System Monorepo",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "concurrently \"npm run dev --workspace=apps/backend-esms\" \"npm run dev --workspace=apps/web-esms\"",
        "dev:backend": "npm run dev --workspace=apps/backend-esms",
        "dev:web": "npm run dev --workspace=apps/web-esms",
        "build": "npm run build --workspaces",
        "test": "npm run test --workspace=apps/backend-esms",
        "test:backend": "npm run test --workspace=apps/backend-esms",
        "db:migrate": "npm run db:migrate --workspace=apps/backend-esms",
        "db:seed": "npm run db:seed --workspace=apps/backend-esms",
        "db:studio": "npm run db:studio --workspace=apps/backend-esms"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}